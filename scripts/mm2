----------------------------------------------------------------------
-- Debug tab: prints every Remotes.Gameplay event to the console (F9),
-- so you can see which event the game fires when a round ends.
----------------------------------------------------------------------
local DebugTab = Window:CreateTab("Debug")
local loggerHooked = false

local function hookEventLogger()
	if loggerHooked then return end
	loggerHooked = true
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
		if not remotes then return end
		local function hook(obj)
			if obj:IsA("RemoteEvent") then
				obj.OnClientEvent:Connect(function(...)
					if not Farm.Debug then return end
					local args = {}
					for i, v in ipairs({ ... }) do args[i] = tostring(v) end
					print(("[Scals Hub] %s  (%s)"):format(obj:GetFullName(), table.concat(args, ", ")))
				end)
			end
		end
		for _, obj in ipairs(remotes:GetDescendants()) do hook(obj) end
		remotes.DescendantAdded:Connect(hook)
	end)
end

DebugTab:CreateToggle({
	Name = "Log Game Events (F9)",
	CurrentValue = false,
	Flag = "DebugLogEvents",
	Callback = function(on)
		Farm.Debug = on
		if on then hookEventLogger() end
	end,
})
DebugTab:CreateLabel("Turn on, play until a round ends, then check F9 for the event name.")

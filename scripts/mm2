--[[
    Scals Hub
    Loads the UI library from GitHub, then builds the hub.
]]
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/rawified/scals-hub/refs/heads/main/ui.luau"))()

----------------------------------------------------------------------
-- COIN AUTO-COLLECT (uses GuiLibrary's toggle, slider and dropdown)
-- Finds whichever map in workspace holds a "CoinContainer" (the map name
-- changes every round). Before every hop it re-reads the coins that are
-- still there, then picks the next target based on the farming mode.
----------------------------------------------------------------------
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Farm = {
	Enabled = false,
	Speed = 60,              -- studs per second
	Noclip = true,
	FarmMode = "Nearest",    -- "Nearest" | "Clusters"
	PositionMode = "Normal", -- "Normal" | "Under Floor"
	ClusterRadius = 30,      -- studs: coins this close together count as one chunk
	FloorDepth = 1.5,        -- studs below the floor surface in Under Floor mode
	RetryAfter = 4,          -- seconds before a coin we already reached may be targeted again
	StopWhenFull = true,     -- pause farming + reset when the coin bag is full
	Debug = false,           -- print game events to the console (F9)
}

local bagFull = false -- set when the bag fills up, cleared when a new round starts

-- Is a round going on right now? Turned ON when the round's coins spawn (CoinsStarted),
-- turned OFF when the round ends for us: we respawn, get teleported away from the
-- coins (back to the lobby), or the map is removed. While OFF the farm does nothing.
local roundActive = false
local roundStartedAt = 0
local hasStartRemote = false -- true once we're listening to the game's CoinsStarted event

----------------------------------------------------------------------
-- Character / map helpers
----------------------------------------------------------------------
local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function findCoinContainer()
	for _, child in ipairs(workspace:GetChildren()) do
		local container = child:FindFirstChild("CoinContainer")
		if container then
			return container
		end
	end
	return nil
end

local function getCoinPosition(coin)
	if coin:IsA("BasePart") then
		return coin.Position
	elseif coin:IsA("Model") then
		return coin:GetPivot().Position
	end
	return nil
end

-- A coin is only still there while it has its CoinVisual; the game removes it
-- when someone collects the coin, even though Coin_Server itself stays behind.
local function isCoinAvailable(coin)
	return coin.Parent ~= nil and coin:FindFirstChild("CoinVisual") ~= nil
end

-- Coins we reached recently: coin -> time reached. Old entries expire, so a coin that
-- didn't register gets another try later.
local reached = setmetatable({}, { __mode = "k" })

-- Fresh list of the coins that are available right now
local function getAvailableCoins(container)
	local now = os.clock()
	local list = {}
	for _, coin in ipairs(container:GetChildren()) do
		if coin.Name == "Coin_Server" and isCoinAvailable(coin) then
			local t = reached[coin]
			if not t or now - t > Farm.RetryAfter then
				local pos = getCoinPosition(coin)
				if pos then
					table.insert(list, { coin = coin, pos = pos })
				end
			end
		end
	end
	return list
end

----------------------------------------------------------------------
-- Farming modes
----------------------------------------------------------------------
local function nearestIn(list, fromPos, filter)
	local best, bestDist
	for _, c in ipairs(list) do
		if not filter or filter(c) then
			local d = (c.pos - fromPos).Magnitude
			if not bestDist or d < bestDist then
				best, bestDist = c, d
			end
		end
	end
	return best
end

-- Clusters: find the chunk with the most coins, clear it nearest-first, then pick the next chunk
local clusterCenter -- Vector3 of the chunk we're clearing, nil when picking a new one

local function pickCluster(list, fromPos)
	local r = Farm.ClusterRadius
	local bestCenter, bestCount, bestDist
	for _, a in ipairs(list) do
		local count = 0
		local sum = Vector3.zero
		for _, b in ipairs(list) do
			if (a.pos - b.pos).Magnitude <= r then
				count += 1
				sum += b.pos
			end
		end
		local center = sum / count
		local d = (center - fromPos).Magnitude
		-- most coins wins; on a tie, the closer chunk wins
		if not bestCount or count > bestCount or (count == bestCount and d < bestDist) then
			bestCenter, bestCount, bestDist = center, count, d
		end
	end
	return bestCenter, bestCount
end

local function chooseTarget(list, fromPos)
	if #list == 0 then return nil end

	if Farm.FarmMode == "Clusters" then
		local r = Farm.ClusterRadius
		local inCluster = function(c)
			return clusterCenter and (c.pos - clusterCenter).Magnitude <= r
		end
		local target = clusterCenter and nearestIn(list, fromPos, inCluster)
		if not target then
			-- current chunk is cleared (or none yet): pick the biggest one left
			clusterCenter = pickCluster(list, fromPos)
			target = nearestIn(list, fromPos, inCluster)
		end
		return target
	end

	return nearestIn(list, fromPos)
end

----------------------------------------------------------------------
-- Position modes
----------------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Y of the floor surface under a coin (nil if nothing is found)
local function floorYBelow(pos, container)
	local ignore = { container }
	if player.Character then table.insert(ignore, player.Character) end
	rayParams.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(pos + Vector3.new(0, 1, 0), Vector3.new(0, -60, 0), rayParams)
	return result and result.Position.Y
end

local LYING = CFrame.Angles(math.rad(90), 0, 0) -- flat on your back

local function targetCFrame(pos, root, container)
	if Farm.PositionMode == "Under Floor" then
		local floorY = floorYBelow(pos, container) or (pos.Y - 3)
		local yaw = select(2, root.CFrame:ToOrientation())
		return CFrame.new(pos.X, floorY - Farm.FloorDepth, pos.Z) * CFrame.Angles(0, yaw, 0) * LYING
	end
	return CFrame.new(pos) * root.CFrame.Rotation
end

----------------------------------------------------------------------
-- Tweening
----------------------------------------------------------------------
-- Extra touch so the coin registers even if the body doesn't overlap it
-- (needed in Under Floor mode, where you sit below the coin)
local function touchCoin(root, coin)
	if typeof(firetouchinterest) ~= "function" then return end
	local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart", true)
	if part then
		pcall(function()
			firetouchinterest(root, part, 0)
			task.wait()
			firetouchinterest(root, part, 1)
		end)
	end
end

local currentTween

local function tweenToCoin(coin, pos, container)
	local root = getRoot()
	if not root then return false end

	local goal = targetCFrame(pos, root, container)
	local distance = (goal.Position - root.Position).Magnitude
	local duration = math.max(distance / Farm.Speed, 0.05)

	local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goal })
	currentTween = tw

	local finished = false
	local conn = tw.Completed:Connect(function(state)
		finished = (state == Enum.PlaybackState.Completed)
	end)
	tw:Play()

	-- Stop early if farming is switched off, the coin gets collected (by us or
	-- someone else), or we die
	while tw.PlaybackState == Enum.PlaybackState.Playing do
		if not Farm.Enabled or not roundActive or bagFull or not isCoinAvailable(coin) or not root.Parent then
			tw:Cancel()
			break
		end
		task.wait()
	end

	conn:Disconnect()
	if currentTween == tw then currentTween = nil end

	if finished and isCoinAvailable(coin) then
		touchCoin(root, coin)
	end
	return finished
end

----------------------------------------------------------------------
-- One farming step (the toggle's Loop calls this over and over while ON)
----------------------------------------------------------------------
local lastContainer

local function farmStep()
	if not Farm.Enabled then return end
	local root = getRoot()
	local container = findCoinContainer()

	-- New round / new map -> start fresh (and the bag is empty again)
	if container ~= lastContainer then
		reached = setmetatable({}, { __mode = "k" })
		clusterCenter = nil
		lastContainer = container
		if not container then
			roundActive = false -- map removed: round is over
		elseif not hasStartRemote then
			-- no CoinsStarted event available: treat a new map as a new round
			bagFull = false
			roundStartedAt = os.clock()
			roundActive = true
		end
	end

	if bagFull or not roundActive then
		task.wait(0.5) -- bag full or round over: wait for the next round
		return
	end

	if not (root and container) then
		task.wait(0.5) -- waiting for the map or a respawn
		return
	end

	-- Refresh what's available right before choosing where to go
	local list = getAvailableCoins(container)
	local target = chooseTarget(list, root.Position)
	if not target then
		task.wait(0.3)
		return
	end

	if tweenToCoin(target.coin, target.pos, container) then
		reached[target.coin] = os.clock()
	end
end

----------------------------------------------------------------------
-- Full bag detection
-- Main method: the game's CoinCollected remote fires on every pickup with
-- (coinType, currentAmount, maxAmount); the bag is full once current >= max.
-- CoinsStarted fires when a new round's coins spawn, which empties the bag.
-- Backup: the bag GUI's FullBagIcon / "Full" label becoming visible.
----------------------------------------------------------------------
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function resetCharacter()
	local hum = getHumanoid()
	if hum and hum.Health > 0 then
		hum.Health = 0
	elseif player.Character then
		player.Character:BreakJoints()
	end
end

local function onBagFull()
	if bagFull or not Farm.Enabled or not Farm.StopWhenFull then return end
	bagFull = true
	if currentTween then currentTween:Cancel() end
	Library:Notify({ Title = "Bag Full", Content = "Stopped farming and reset. Resumes next round.", Duration = 4 })
	task.wait(0.2)
	resetCharacter()
end

local function onNewRound()
	bagFull = false
	reached = setmetatable({}, { __mode = "k" })
	clusterCenter = nil
	roundStartedAt = os.clock()
	roundActive = true
end

local function endRound(reason)
	if not roundActive then return end
	roundActive = false
	clusterCenter = nil
	if currentTween then currentTween:Cancel() end
	if Farm.Debug then print("[Scals Hub] round over for us:", reason) end
end

task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	local gameplay = remotes and remotes:WaitForChild("Gameplay", 10)
	if not gameplay then
		warn("[Scals Hub] Remotes.Gameplay not found, using the bag GUI check only")
		return
	end

	local collected = gameplay:WaitForChild("CoinCollected", 10)
	if collected then
		collected.OnClientEvent:Connect(function(_coinType, currentAmount, maxAmount)
			local current, max = tonumber(currentAmount), tonumber(maxAmount)
			if current and max and current >= max then
				task.spawn(onBagFull)
			end
		end)
	end

	local started = gameplay:WaitForChild("CoinsStarted", 10)
	if started then
		hasStartRemote = true
		started.OnClientEvent:Connect(onNewRound)
	end
end)

-- Backup check: any "Container" in the game's GUI with a visible FullBagIcon or "Full" label
local function guiSaysFull()
	local pg = player:FindFirstChild("PlayerGui")
	if not pg then return false end
	for _, gui in ipairs(pg:GetChildren()) do
		if gui:IsA("ScreenGui") then
			local container = gui:FindFirstChild("Container", true)
			if container then
				for _, frame in ipairs(container:GetChildren()) do
					if frame:IsA("Frame") and frame.Visible then
						local icon = frame:FindFirstChild("FullBagIcon", true)
						local text = frame:FindFirstChild("Full", true)
						if (icon and icon.Visible) or (text and text.Visible) then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

task.spawn(function()
	local wasFull = false
	while true do
		task.wait(0.5)
		-- only when it switches to full, so a "Full" icon left over from last round can't
		-- reset you again at the start of the next one
		local full = guiSaysFull()
		if full and not wasFull and Farm.Enabled and not bagFull then
			onBagFull()
		end
		wasFull = full
	end
end)

----------------------------------------------------------------------
-- Round end detection
----------------------------------------------------------------------
-- If the script is started in the middle of a round, CoinsStarted already fired,
-- so count a loaded map with coins on it as a running round.
task.defer(function()
	local container = findCoinContainer()
	if container and #getAvailableCoins(container) > 0 then
		roundActive = true
	end
end)

-- 1) We respawned (died, reset, or the game reloaded us at round end)
player.CharacterAdded:Connect(function()
	-- some games respawn everyone into the map at round start; don't count that
	if os.clock() - roundStartedAt > 5 then
		endRound("respawned")
	end
end)

-- 2) We got teleported far away from the coins (sent back to the lobby).
--    Our own tweens move us smoothly, so a sudden big jump is the game teleporting us.
local lastRootPos
RunService.Heartbeat:Connect(function()
	local root = getRoot()
	if not root then lastRootPos = nil; return end
	local pos = root.Position
	if lastRootPos and roundActive and (pos - lastRootPos).Magnitude > 100
		and os.clock() - roundStartedAt > 5 then -- ignore the teleport into the map at round start
		local container = findCoinContainer()
		local nearest = container and nearestIn(getAvailableCoins(container), pos)
		if not nearest or (nearest.pos - pos).Magnitude > 300 then
			endRound("teleported away from the map")
		end
	end
	lastRootPos = pos
end)

-- 3) The map / CoinContainer got removed (handled in farmStep)

----------------------------------------------------------------------
-- Noclip, no falling, and lying still while farming
----------------------------------------------------------------------
-- Only while actually farming: enabled, bag not full, and a map with coins is loaded
-- (so you can move normally in the lobby and after a full-bag reset)
local function farmingActive()
	return Farm.Enabled and roundActive and not bagFull and lastContainer ~= nil and lastContainer.Parent ~= nil
end

local function underFloor()
	return farmingActive() and Farm.PositionMode == "Under Floor"
end

RunService.Stepped:Connect(function()
	-- Under Floor always needs noclip, otherwise the floor pushes you back up
	if not (farmingActive() and (Farm.Noclip or underFloor())) then return end
	local char = player.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
end)

local platformStanding = false
local function setPlatformStand(on)
	local hum = getHumanoid()
	if hum then hum.PlatformStand = on end
	platformStanding = on
end

RunService.Heartbeat:Connect(function()
	-- Keeps the character from trying to stand back up while lying under the floor
	local want = underFloor()
	if want then
		local hum = getHumanoid()
		if hum and not hum.PlatformStand then hum.PlatformStand = true end
		platformStanding = true
	elseif platformStanding then
		setPlatformStand(false)
	end

	if not farmingActive() then return end
	local root = getRoot()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end)

----------------------------------------------------------------------
-- UI
----------------------------------------------------------------------
local Window = Library:CreateWindow({
	Name = "Scals Hub",
	Theme = "Monochrome",                  -- Dark, Light, Ocean, Rose, Forest, Monochrome
	InfoBar = true,                        -- ping / fps / time, top right
	ConfigurationSaving = {
		Enabled = true,
		FolderName = "ScalsHub",
		FileName = "mm2Config",
	},
	-- Upload SCALS_logo.png at create.roblox.com > Creator Hub > Images, then paste the id here.
	-- Remove the Image line (or set Splash = false) to skip the picture / the whole splash.
	Splash = {
		Image = "rbxassetid://114362863794226",
		Duration = 4.5,
		Subtitle = "loading example",
	},
})

local FarmTab = Window:CreateTab("Farming")

FarmTab:CreateToggle({
	Name = "Auto Collect Coins",
	CurrentValue = false,
	Flag = "AutoCollectCoins",
	Callback = function(on)
		Farm.Enabled = on
		clusterCenter = nil
		if on then
			if not findCoinContainer() then
				Library:Notify({ Title = "Auto Collect", Content = "No map loaded yet, waiting for the round to start.", Duration = 3 })
			end
		elseif currentTween then
			currentTween:Cancel()
		end
	end,
	Loop = farmStep,
	Interval = 0.05,
})

FarmTab:CreateDropdown({
	Name = "Farming Mode",
	Options = { "Nearest", "Clusters" },
	CurrentOption = Farm.FarmMode,
	Flag = "CoinFarmMode",
	Callback = function(mode)
		Farm.FarmMode = mode
		clusterCenter = nil
	end,
})

FarmTab:CreateDropdown({
	Name = "Position Mode",
	Options = { "Normal", "Under Floor" },
	CurrentOption = Farm.PositionMode,
	Flag = "CoinPositionMode",
	Callback = function(mode)
		Farm.PositionMode = mode
	end,
})

FarmTab:CreateSlider({
	Name = "Tween Speed",
	Range = { 10, 300 },
	Increment = 1,
	Suffix = "studs/s",
	CurrentValue = Farm.Speed,
	Flag = "CoinTweenSpeed",
	Callback = function(v)
		Farm.Speed = v
	end,
})

FarmTab:CreateSlider({
	Name = "Cluster Radius",
	Range = { 10, 80 },
	Increment = 1,
	Suffix = "studs",
	CurrentValue = Farm.ClusterRadius,
	Flag = "CoinClusterRadius",
	Callback = function(v)
		Farm.ClusterRadius = v
		clusterCenter = nil
	end,
})

FarmTab:CreateSlider({
	Name = "Under Floor Depth",
	Range = { 0.5, 6 },
	Increment = 0.5,
	Suffix = "studs",
	CurrentValue = Farm.FloorDepth,
	Flag = "CoinFloorDepth",
	Callback = function(v)
		Farm.FloorDepth = v
	end,
})

FarmTab:CreateToggle({
	Name = "Stop & Reset When Bag Full",
	CurrentValue = true,
	Flag = "CoinStopWhenFull",
	Callback = function(on)
		Farm.StopWhenFull = on
	end,
})

FarmTab:CreateToggle({
	Name = "Noclip While Farming",
	CurrentValue = true,
	Flag = "CoinNoclip",
	Callback = function(on)
		Farm.Noclip = on
	end,
})

FarmTab:CreateLabel("Clusters: clears the biggest group of coins first, then the next.")
FarmTab:CreateLabel("Under Floor always uses noclip. Speeds above ~150 may get you flagged.")

----------------------------------------------------------------------
-- ROLE ESP
-- A player's role is read from their tools (Backpack or held in hand):
--   Knife -> Murderer, Gun -> Sheriff, neither -> Innocent
----------------------------------------------------------------------
local Esp = {
	Enabled = false,
	Highlights = true, -- colored glow through walls
	Labels = true,     -- name + role above the head
	ShowInnocents = true,
}

local RoleColors = {
	Murderer = Color3.fromRGB(255, 60, 60),
	Sheriff = Color3.fromRGB(70, 150, 255),
	Innocent = Color3.fromRGB(80, 230, 120),
}

local function hasTool(plr, name)
	local bp = plr:FindFirstChildOfClass("Backpack")
	local char = plr.Character
	return (bp and bp:FindFirstChild(name)) or (char and char:FindFirstChild(name))
end

local function getRole(plr)
	if hasTool(plr, "Knife") then return "Murderer" end
	if hasTool(plr, "Gun") then return "Sheriff" end
	return "Innocent"
end

-- Hidden container the game can't see (executor GUI folder, then CoreGui, then PlayerGui)
local espParent
pcall(function()
	if typeof(gethui) == "function" then espParent = gethui() end
end)
if not espParent then
	pcall(function()
		local core = game:GetService("CoreGui")
		local probe = Instance.new("Folder")
		probe.Parent = core
		probe:Destroy()
		espParent = core
	end)
end
espParent = espParent or player:WaitForChild("PlayerGui")

local espFolder = Instance.new("Folder")
espFolder.Name = "ScalsRoleESP"
espFolder.Parent = espParent

local espObjects = {} -- [Player] = { highlight, billboard, label }

local function makeEsp(plr)
	if plr == player or espObjects[plr] then return end
	local hl = Instance.new("Highlight")
	hl.Enabled = false
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillTransparency = 0.6
	hl.OutlineTransparency = 0
	hl.Parent = espFolder

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 20)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.AlwaysOnTop = true
	bb.Enabled = false
	bb.Parent = espFolder

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextStrokeTransparency = 0.3
	label.Parent = bb

	espObjects[plr] = { highlight = hl, billboard = bb, label = label }
end

local function removeEspFor(plr)
	local e = espObjects[plr]
	if not e then return end
	e.highlight:Destroy()
	e.billboard:Destroy()
	espObjects[plr] = nil
end

for _, plr in ipairs(Players:GetPlayers()) do makeEsp(plr) end
Players.PlayerAdded:Connect(makeEsp)
Players.PlayerRemoving:Connect(removeEspFor)

-- Roles only change a few times per round, so 5 checks a second is plenty
task.spawn(function()
	while true do
		local myRoot = getRoot()
		for plr, e in pairs(espObjects) do
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local head = char and char:FindFirstChild("Head")
			local role = getRole(plr)
			local show = Esp.Enabled and char and hum and hum.Health > 0
				and (Esp.ShowInnocents or role ~= "Innocent")

			if show then
				local color = RoleColors[role]
				e.highlight.Adornee = char
				e.highlight.FillColor = color
				e.highlight.OutlineColor = color
				e.highlight.Enabled = Esp.Highlights

				e.billboard.Adornee = head
				local dist = myRoot and char:FindFirstChild("HumanoidRootPart")
					and math.floor((myRoot.Position - char.HumanoidRootPart.Position).Magnitude + 0.5)
				e.label.Text = dist and ("%s [%s] %dm"):format(plr.DisplayName, role, dist)
					or ("%s [%s]"):format(plr.DisplayName, role)
				e.label.TextColor3 = color
				e.billboard.Enabled = Esp.Labels and head ~= nil
			else
				e.highlight.Enabled = false
				e.billboard.Enabled = false
			end
		end
		task.wait(0.2)
	end
end)

----------------------------------------------------------------------
-- KILL ALL (murderer only)
-- Equips your knife, then for each living player: pins their character right
-- in front of you (on your screen only) and stabs until they die or time runs out.
----------------------------------------------------------------------
local Kill = {
	PerTarget = 1.5, -- max seconds spent on one player before moving on
	Running = false,
}

local function myKnife()
	local char = player.Character
	local bp = player:FindFirstChildOfClass("Backpack")
	return (char and char:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife"))
end

local function stab(knife, targetRoot)
	knife:Activate()
	local handle = knife:FindFirstChild("Handle")
	if handle and typeof(firetouchinterest) == "function" then
		pcall(function()
			firetouchinterest(handle, targetRoot, 0)
			firetouchinterest(handle, targetRoot, 1)
		end)
	end
end

local function killAll()
	if Kill.Running then return end
	local knife = myKnife()
	if not knife then
		Library:Notify({ Title = "Kill All", Content = "You don't have the knife, you're not the murderer.", Duration = 3 })
		return
	end
	local hum, root = getHumanoid(), getRoot()
	if not (hum and root and hum.Health > 0) then return end

	Kill.Running = true
	if knife.Parent ~= player.Character then
		hum:EquipTool(knife)
		task.wait(0.15)
	end

	local killed = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if not Kill.Running then break end
		if plr ~= player then
			local char = plr.Character
			local thum = char and char:FindFirstChildOfClass("Humanoid")
			local troot = char and char:FindFirstChild("HumanoidRootPart")
			if thum and troot and thum.Health > 0 then
				local deadline = os.clock() + Kill.PerTarget
				local lastStab = 0
				while thum.Parent and thum.Health > 0 and os.clock() < deadline do
					root = getRoot()
					if not root or knife.Parent ~= player.Character then break end
					-- keep them 2 studs in front of you, every frame
					troot.CFrame = root.CFrame * CFrame.new(0, 0, -2)
					troot.AssemblyLinearVelocity = Vector3.zero
					if os.clock() - lastStab > 0.1 then
						lastStab = os.clock()
						stab(knife, troot)
					end
					RunService.Heartbeat:Wait()
				end
				if thum.Health <= 0 then killed += 1 end
			end
		end
	end

	Kill.Running = false
	Library:Notify({ Title = "Kill All", Content = ("Done, %d killed."):format(killed), Duration = 3 })
end

